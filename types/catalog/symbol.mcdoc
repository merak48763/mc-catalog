// arrow (a) - "▶ "
// condition (c) - "▍ "
// dot (d) - "◆ "
dispatch catalog:keys/prefix[
  "empty",
  "c",
  "d",
  "c+a",
  "c+c",
  "d+d",
  "ca+d",
  "cc+a",
  "cc+d",
  "cca+d",
  "ccd+d",
] to ()

